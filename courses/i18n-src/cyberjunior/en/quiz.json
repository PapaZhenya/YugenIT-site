  "week-03": [
    { "id": "3.1", "type": "mc", "text": "Which command changes a file's access permissions on Linux?", "options": { "A": "chown", "B": "chmod", "C": "ls", "D": "grep" }, "correct": "B" },
    { "id": "3.2", "type": "mc", "text": "Permissions 777 mean:", "options": { "A": "Read access for everyone", "B": "Full access (rwx) for everyone", "C": "Access for the owner only", "D": "No access" }, "correct": "B" },
    { "id": "3.3", "type": "mc", "text": "Where are authentication logs located on Linux?", "options": { "A": "/etc/passwd", "B": "/var/log/auth.log", "C": "/home", "D": "/tmp" }, "correct": "B" },
    { "id": "3.4", "type": "tf", "text": "sudo grants temporary superuser privileges.", "correct": "Верно" },
    { "id": "3.5", "type": "tf", "text": "On Windows, event logs are viewed via Event Viewer.", "correct": "Верно" },
