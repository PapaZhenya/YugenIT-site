    { "id": "6.2", "type": "mc", "text": "A tool for brute-forcing a live SSH service:", "options": { "A": "John the Ripper", "B": "Hydra", "C": "Wireshark", "D": "Nmap" }, "correct": "B" },
    { "id": "6.3", "type": "mc", "text": "The most common social engineering vector:", "options": { "A": "Physical break-in", "B": "Phishing", "C": "DDoS", "D": "SQL injection" }, "correct": "B" },
    { "id": "6.4", "type": "tf", "text": "MFA neutralizes most password-based attacks.", "correct": "Верно" },
