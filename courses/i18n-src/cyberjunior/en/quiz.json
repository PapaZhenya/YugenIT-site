    { "id": "1.10", "type": "mc", "text": "What does the principle of least privilege mean?", "options": { "A": "Everyone gets root", "B": "Only the minimum necessary rights", "C": "Disable logging", "D": "One password for everyone" }, "correct": "B" },
    { "id": "1.11", "type": "mc", "text": "What is AAA in security?", "options": { "A": "Three antivirus programs", "B": "Authentication, authorization, accounting", "C": "A type of encryption", "D": "A network model" }, "correct": "B" },
    { "id": "1.12", "type": "tf", "text": "Defense in depth means having multiple layers of defense.", "correct": "Верно" },
    { "id": "1.13", "type": "tf", "text": "Most attacks carefully target one specific victim.", "correct": "Неверно" },
    { "id": "1.14", "type": "open", "text": "How does an exploit differ from a vulnerability?" },
    { "id": "1.15", "type": "open", "text": "What is risk in the security formula?" },
    { "id": "1.16", "type": "open", "text": "Give an example of the principle of least privilege." }
  ],
  "week-02": [
