  "week-07": [
    { "id": "7.1", "type": "mc", "text": "Symmetric encryption uses:", "options": { "A": "A key pair", "B": "One shared key", "C": "Only a hash", "D": "No keys" }, "correct": "B" },
    { "id": "7.2", "type": "mc", "text": "An example of an asymmetric algorithm:", "options": { "A": "AES", "B": "RSA", "C": "SHA-256", "D": "MD5" }, "correct": "B" },
    { "id": "7.3", "type": "mc", "text": "How does hashing differ from encryption?", "options": { "A": "It doesn't", "B": "It's irreversible", "C": "It encrypts faster", "D": "It can be decrypted with a key" }, "correct": "B" },
    { "id": "7.4", "type": "tf", "text": "TLS uses both asymmetric and symmetric encryption.", "correct": "Верно" },
    { "id": "7.5", "type": "tf", "text": "Hardening increases the attack surface.", "correct": "Неверно" },
    { "id": "7.6", "type": "mc", "text": "The principle of least privilege means:", "options": { "A": "Everyone gets root", "B": "Only the minimum necessary rights", "C": "Disable logging", "D": "One password for everyone" }, "correct": "B" },
    { "id": "7.7", "type": "open", "text": "When is hashing enough, and when is encryption needed?" },
    { "id": "7.8", "type": "open", "text": "What are the two steps of establishing TLS?" },
