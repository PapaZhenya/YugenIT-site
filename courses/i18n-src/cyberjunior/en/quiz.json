    { "id": "2.10", "type": "mc", "text": "What does a VPN do on open Wi-Fi?", "options": { "A": "Speeds things up", "B": "Encrypts your traffic", "C": "Changes the site's IP address", "D": "Disables DNS" }, "correct": "B" },
    { "id": "2.11", "type": "mc", "text": "Port scanning is usually classified as:", "options": { "A": "Data protection", "B": "Reconnaissance / attack preparation", "C": "Encryption", "D": "Backup" }, "correct": "B" },
    { "id": "2.12", "type": "tf", "text": "Each OSI layer is associated with its own class of threats.", "correct": "Верно" },
