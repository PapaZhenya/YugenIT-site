    { "id": "3.7", "type": "open", "text": "Why are 777 permissions on a configuration file dangerous?" },
    { "id": "3.8", "type": "open", "text": "How can you count failed logins in auth.log with a single command?" },
    { "id": "3.9", "type": "mc", "text": "Who is root on Linux?", "options": { "A": "A regular user", "B": "The superuser", "C": "A service", "D": "A port" }, "correct": "B" },
    { "id": "3.10", "type": "mc", "text": "What does an attacker aim for when escalating privileges?", "options": { "A": "Guest access", "B": "root access", "C": "The logs", "D": "DNS" }, "correct": "B" },
    { "id": "3.11", "type": "mc", "text": "Where does malware often persist?", "options": { "A": "In autostart/startup items", "B": "In the monitor", "C": "In the cable", "D": "In the subnet mask" }, "correct": "A" },
    { "id": "3.12", "type": "tf", "text": "777 permissions on a file are dangerous.", "correct": "Верно" },
    { "id": "3.13", "type": "tf", "text": "history -c is guaranteed to destroy all traces.", "correct": "Неверно" },
    { "id": "3.14", "type": "open", "text": "What does sudo do?" },
    { "id": "3.15", "type": "open", "text": "Why are excessive file permissions dangerous?" },
    { "id": "3.16", "type": "open", "text": "How do you count failed logins in auth.log?" }
