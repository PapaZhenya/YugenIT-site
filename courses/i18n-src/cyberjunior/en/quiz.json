    { "id": "4.11", "type": "mc", "text": "The Nmap flag for discovering live hosts:", "options": { "A": "-sV", "B": "-sn", "C": "-p-", "D": "-A" }, "correct": "B" },
    { "id": "4.12", "type": "tf", "text": "Passive reconnaissance doesn't directly contact the target.", "correct": "Верно" },
    { "id": "4.13", "type": "tf", "text": "Scanning someone else's network without permission is legal.", "correct": "Неверно" },
    { "id": "4.14", "type": "open", "text": "Why should a defender scan their own network?" },
    { "id": "4.15", "type": "open", "text": "Why is an outdated service version dangerous?" },
    { "id": "4.16", "type": "open", "text": "What does a target map include?" }
