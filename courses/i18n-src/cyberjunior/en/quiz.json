    { "id": "5.10", "type": "mc", "text": "The root cause of injection vulnerabilities is:", "options": { "A": "A slow server", "B": "Mixing data and code", "C": "Weak Wi-Fi", "D": "An old browser" }, "correct": "B" },
    { "id": "5.11", "type": "mc", "text": "What protects a cookie from being stolen via JavaScript?", "options": { "A": "HTTPS", "B": "The HttpOnly flag", "C": "A long password", "D": "NAT" }, "correct": "B" },
    { "id": "5.12", "type": "tf", "text": "Parameterized queries protect against SQL injection.", "correct": "Верно" },
    { "id": "5.13", "type": "tf", "text": "HTTPS protects a site from SQL injection and XSS.", "correct": "Неверно" },
    { "id": "5.14", "type": "open", "text": "Why do parameterized queries protect against injection?" },
