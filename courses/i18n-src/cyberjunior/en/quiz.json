{
  "week-01": [
    { "id": "1.1", "type": "mc", "text": "What does the letter \"I\" stand for in the CIA triad?", "options": { "A": "Identity", "B": "Integrity", "C": "Isolation", "D": "Injection" }, "correct": "B" },
    { "id": "1.2", "type": "mc", "text": "Who usually has the LOWEST skill level?", "options": { "A": "APT group", "B": "Insider", "C": "Script kiddie", "D": "Cybercriminal group" }, "correct": "C" },
    { "id": "1.3", "type": "tf", "text": "Availability is violated during a DDoS attack.", "correct": "Верно" },
    { "id": "1.4", "type": "tf", "text": "Threat modeling is only needed by large companies.", "correct": "Неверно" },
    { "id": "1.5", "type": "mc", "text": "The letter \"S\" in STRIDE refers to:", "options": { "A": "Scanning", "B": "Spoofing", "C": "Sniffing", "D": "Sandboxing" }, "correct": "B" },
