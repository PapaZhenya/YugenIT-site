  "week-05": [
    { "id": "5.1", "type": "mc", "text": "What protects most reliably against SQL injection?", "options": { "A": "Hiding error messages", "B": "Parameterized queries", "C": "Changing the database port", "D": "Long passwords" }, "correct": "B" },
    { "id": "5.2", "type": "mc", "text": "Stored XSS is distinguished by the fact that it:", "options": { "A": "Is faster", "B": "Is stored on the server and hits many users", "C": "Doesn't require JS", "D": "Is safer" }, "correct": "B" },
    { "id": "5.3", "type": "mc", "text": "The input ' OR '1'='1 is an example of:", "options": { "A": "XSS", "B": "SQL injection", "C": "Phishing", "D": "Brute force" }, "correct": "B" },
    { "id": "5.4", "type": "tf", "text": "The HttpOnly flag prevents a cookie from being stolen via JavaScript.", "correct": "Верно" },
    { "id": "5.5", "type": "tf", "text": "Security misconfiguration is rare.", "correct": "Неверно" },
    { "id": "5.6", "type": "mc", "text": "The OWASP Top 10 is:", "options": { "A": "A scanner", "B": "A list of 10 critical web risks", "C": "An encryption standard", "D": "A language" }, "correct": "B" },
    { "id": "5.7", "type": "open", "text": "Why do parameterized queries protect against injection?" },
