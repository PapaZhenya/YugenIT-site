    { "id": "7.10", "type": "mc", "text": "What is hashing used for?", "options": { "A": "Data recovery", "B": "Integrity checks and password storage", "C": "Key exchange", "D": "Routing" }, "correct": "B" },
    { "id": "7.11", "type": "mc", "text": "What does TLS use for speed after the key exchange?", "options": { "A": "Asymmetric encryption", "B": "Symmetric encryption", "C": "Hashing", "D": "NAT" }, "correct": "B" },
