    { "id": "7.14", "type": "mc", "text": "Що зручніше для покриття великого будинку?", "options": { "A": "Один репітер", "B": "Mesh-система", "C": "Вимкнути 5 ГГц", "D": "Приховати SSID" }, "correct": "B" },
    { "id": "7.15", "type": "mc", "text": "Навіщо потрібна гостьова мережа?", "options": { "A": "Прискорити Wi-Fi", "B": "Ізолювати гостей і розумні пристрої", "C": "Змінити SSID", "D": "Роздати адреси" }, "correct": "B" },
    { "id": "7.16", "type": "tf", "text": "Приховування SSID робить мережу по-справжньому захищеною.", "correct": "Неверно" },
