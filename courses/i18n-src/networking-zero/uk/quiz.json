{
  "module-01": [
    { "id": "1.1", "type": "mc", "text": "Як називають невелику порцію даних, на які дроблять повідомлення?", "options": { "A": "Кадр", "B": "Пакет", "C": "Байт", "D": "Кластер" }, "correct": "B" },
    { "id": "1.2", "type": "mc", "text": "Хто такі «хости» в мережі?", "options": { "A": "Тільки сервери", "B": "Пристрої-відправники та отримувачі", "C": "Кабелі", "D": "Протоколи" }, "correct": "B" },
    { "id": "1.3", "type": "mc", "text": "Що з переліченого — середовище передачі даних?", "options": { "A": "Протокол", "B": "Оптоволокно", "C": "Пакет", "D": "Заголовок" }, "correct": "B" },
    { "id": "1.4", "type": "mc", "text": "Навіщо в мережі потрібні протоколи?", "options": { "A": "Прискорювати кабель", "B": "Задавати спільні правила обміну", "C": "Зберігати паролі", "D": "Роздавати імена" }, "correct": "B" },
    { "id": "1.5", "type": "mc", "text": "З яких двох частин складається пакет?", "options": { "A": "Кабель і сигнал", "B": "Дані та заголовок", "C": "IP і MAC", "D": "Порт і адреса" }, "correct": "B" },
    { "id": "1.6", "type": "tf", "text": "Дані дроблять на пакети, щоб мережа була надійнішою.", "correct": "Верно" },
    { "id": "1.7", "type": "tf", "text": "Протоколи — це марки мережевих кабелів.", "correct": "Неверно" },
    { "id": "1.8", "type": "tf", "text": "Різні пакети одного повідомлення можуть іти різними маршрутами.", "correct": "Верно" },
    { "id": "1.9", "type": "tf", "text": "Інтернет — це одна велика машина.", "correct": "Неверно" },
    { "id": "1.10", "type": "open", "text": "Своїми словами: що відбувається від натискання Enter до появи сторінки?" },
    { "id": "1.11", "type": "open", "text": "Чому вигідно дробити дані на пакети?" },
    { "id": "1.12", "type": "open", "text": "Що таке протокол одним реченням?" },
    { "id": "1.13", "type": "mc", "text": "Що таке смуга пропускання?", "options": { "A": "Час відгуку", "B": "Скільки даних проходить за секунду", "C": "Кількість пристроїв", "D": "Тип кабелю" }, "correct": "B" },
    { "id": "1.14", "type": "mc", "text": "Що таке затримка (latency)?", "options": { "A": "Ширина каналу", "B": "Час сигналу туди-назад", "C": "Втрата пакетів", "D": "Адреса" }, "correct": "B" },
    { "id": "1.15", "type": "mc", "text": "У схемі «клієнт — сервер» браузер це:", "options": { "A": "Сервер", "B": "Клієнт", "C": "Роутер", "D": "Протокол" }, "correct": "B" },
    { "id": "1.16", "type": "tf", "text": "Для онлайн-ігор затримка важливіша за швидкість завантаження.", "correct": "Верно" },
    { "id": "1.17", "type": "tf", "text": "Смуга пропускання і затримка — це одне й те саме.", "correct": "Неверно" },
    { "id": "1.18", "type": "open", "text": "Чим смуга пропускання відрізняється від затримки?" },
    { "id": "1.19", "type": "open", "text": "Що таке localhost і яка в нього адреса?" },
    { "id": "1.20", "type": "open", "text": "Наведи приклад пристрою-сервера в домашній мережі." }
  ],
  "module-02": [
    { "id": "2.1", "type": "mc", "text": "Що показує IP-адреса?", "options": { "A": "Програму", "B": "Пристрій у мережі", "C": "Швидкість", "D": "Тип кабелю" }, "correct": "B" },
    { "id": "2.2", "type": "mc", "text": "Що робить DNS?", "options": { "A": "Видає налаштування", "B": "Перетворює ім'я на IP-адресу", "C": "Шифрує трафік", "D": "З'єднує мережі" }, "correct": "B" },
    { "id": "2.3", "type": "mc", "text": "До чого веде порт?", "options": { "A": "До пристрою", "B": "До конкретної програми на пристрої", "C": "До мережі", "D": "До кабелю" }, "correct": "B" },
    { "id": "2.4", "type": "mc", "text": "Що показує маска /24?", "options": { "A": "Швидкість", "B": "Перші 3 числа — мережа, останнє — пристрій", "C": "Пароль", "D": "Порт" }, "correct": "B" },
    { "id": "2.5", "type": "mc", "text": "Скільки адрес для пристроїв у мережі /24?", "options": { "A": "254", "B": "256", "C": "128", "D": "64" }, "correct": "A" },
    { "id": "2.6", "type": "mc", "text": "Яка адреса приватна?", "options": { "A": "8.8.8.8", "B": "192.168.1.10", "C": "93.184.216.34", "D": "1.1.1.1" }, "correct": "B" },
    { "id": "2.7", "type": "mc", "text": "Порт HTTPS за замовчуванням?", "options": { "A": "80", "B": "443", "C": "53", "D": "22" }, "correct": "B" },
    { "id": "2.8", "type": "tf", "text": "Маска підмережі задає межу між мережевою і хостовою частиною адреси.", "correct": "Верно" },
    { "id": "2.9", "type": "tf", "text": "Приватні адреси напряму видно в інтернеті.", "correct": "Неверно" },
    { "id": "2.10", "type": "tf", "text": "IPv6 придумали через нестачу адрес IPv4.", "correct": "Верно" },
    { "id": "2.11", "type": "open", "text": "Навіщо потрібен DNS?" },
    { "id": "2.12", "type": "open", "text": "Наведи аналогію для зв'язки «IP + порт»." },
    { "id": "2.13", "type": "mc", "text": "Яка адреса означає «сам себе» (localhost)?", "options": { "A": "0.0.0.0", "B": "127.0.0.1", "C": "192.168.1.1", "D": "255.255.255.255" }, "correct": "B" },
    { "id": "2.14", "type": "mc", "text": "Широкомовна адреса мережі 192.168.1.0/24:", "options": { "A": "192.168.1.0", "B": "192.168.1.1", "C": "192.168.1.255", "D": "192.168.1.254" }, "correct": "C" },
    { "id": "2.15", "type": "mc", "text": "Навіщо DNS-відповіді кешуються?", "options": { "A": "Для шифрування", "B": "Щоб не питати щоразу і прискорити", "C": "Для безпеки", "D": "Випадково" }, "correct": "B" },
    { "id": "2.16", "type": "tf", "text": "Адресу мережі (наприклад, 192.168.1.0) не призначають пристрою.", "correct": "Верно" },
    { "id": "2.17", "type": "tf", "text": "Статична адреса змінюється сама по собі.", "correct": "Неверно" },
    { "id": "2.18", "type": "open", "text": "Скільки пристроїв поміщається в мережу /26?" },
    { "id": "2.19", "type": "open", "text": "Коли зручніша статична адреса, а коли динамічна?" },
    { "id": "2.20", "type": "open", "text": "Що станеться при зверненні до 127.0.0.1?" }
  ],
  "module-03": [
    { "id": "3.1", "type": "mc", "text": "Скільки рівнів у моделі TCP/IP?", "options": { "A": "4", "B": "5", "C": "7", "D": "3" }, "correct": "A" },
    { "id": "3.2", "type": "mc", "text": "На якому рівні TCP/IP працюють IP-адреси?", "options": { "A": "Канальному", "B": "Мережевому", "C": "Транспортному", "D": "Прикладному" }, "correct": "B" },
    { "id": "3.3", "type": "mc", "text": "Скільки рівнів у моделі OSI?", "options": { "A": "4", "B": "5", "C": "7", "D": "6" }, "correct": "C" },
    { "id": "3.4", "type": "mc", "text": "Як називається додавання заголовків по рівнях?", "options": { "A": "Маршрутизація", "B": "Інкапсуляція", "C": "Комутація", "D": "Трансляція" }, "correct": "B" },
    { "id": "3.5", "type": "mc", "text": "Дані з транспортним заголовком називаються:", "options": { "A": "Кадр", "B": "Пакет", "C": "Сегмент", "D": "Біт" }, "correct": "C" },
    { "id": "3.6", "type": "mc", "text": "На якому рівні працюють MAC-адреси?", "options": { "A": "Канальному", "B": "Мережевому", "C": "Транспортному", "D": "Прикладному" }, "correct": "A" },
    { "id": "3.7", "type": "tf", "text": "TCP надійний і підтверджує доставку, UDP швидкий і без гарантій.", "correct": "Верно" },
    { "id": "3.8", "type": "tf", "text": "OSI і TCP/IP — конкурентні несумісні моделі.", "correct": "Неверно" },
    { "id": "3.9", "type": "tf", "text": "Поділ на рівні допомагає швидше знаходити несправності.", "correct": "Верно" },
    { "id": "3.10", "type": "open", "text": "Навіщо мережу ділять на рівні?" },
    { "id": "3.11", "type": "open", "text": "Чим сегмент відрізняється від кадру?" },
    { "id": "3.12", "type": "open", "text": "Наведи приклад, коли UDP кращий за TCP." },
    { "id": "3.13", "type": "mc", "text": "Що обирає маршрутизатор за наявності кількох придатних маршрутів?", "options": { "A": "Перший-ліпший", "B": "Найточніший (longest prefix)", "C": "Випадковий", "D": "Найкоротший за іменем" }, "correct": "B" },
    { "id": "3.14", "type": "mc", "text": "Одиниця даних на канальному рівні:", "options": { "A": "Сегмент", "B": "Пакет", "C": "Кадр", "D": "Біт" }, "correct": "C" },
    { "id": "3.15", "type": "mc", "text": "Для чого краще підходить UDP?", "options": { "A": "Завантаження файлу", "B": "Онлайн-відео та ігри", "C": "Завантаження сайту", "D": "Електронна пошта" }, "correct": "B" },
    { "id": "3.16", "type": "tf", "text": "TCP нумерує сегменти, щоб зібрати їх по порядку.", "correct": "Верно" },
    { "id": "3.17", "type": "tf", "text": "Фізичний рівень є в TCP/IP як окремий з чотирьох.", "correct": "Неверно" },
    { "id": "3.18", "type": "open", "text": "Назви одиниці даних на транспортному, мережевому та канальному рівнях." },
    { "id": "3.19", "type": "open", "text": "Чому TCP вважається надійним?" },
    { "id": "3.20", "type": "open", "text": "На якому рівні здебільшого працює Wi-Fi?" }
  ],
  "module-04": [
    { "id": "4.1", "type": "mc", "text": "Що таке MAC-адреса?", "options": { "A": "Ім'я мережі", "B": "Фізична адреса мережевої картки", "C": "IP-адреса", "D": "Порт" }, "correct": "B" },
    { "id": "4.2", "type": "mc", "text": "За якими адресами комутатор доставляє кадри?", "options": { "A": "IP", "B": "MAC", "C": "DNS", "D": "SSID" }, "correct": "B" },
    { "id": "4.3", "type": "mc", "text": "Що комутатор зберігає у своїй таблиці?", "options": { "A": "Паролі", "B": "MAC-адреса → порт", "C": "Маршрути назовні", "D": "Імена сайтів" }, "correct": "B" },
    { "id": "4.4", "type": "mc", "text": "Як називається «конверт» даних у локальній мережі?", "options": { "A": "Пакет", "B": "Кадр", "C": "Сегмент", "D": "Біт" }, "correct": "B" },
    { "id": "4.5", "type": "mc", "text": "Чим поганий старий хаб порівняно з комутатором?", "options": { "A": "Занадто швидкий", "B": "Розсилає всім і створює колізії", "C": "Дорогий", "D": "Шифрує трафік" }, "correct": "B" },
    { "id": "4.6", "type": "mc", "text": "Що дозволяє логічно розділити один комутатор на кілька мереж?", "options": { "A": "NAT", "B": "VLAN", "C": "DNS", "D": "DHCP" }, "correct": "B" },
    { "id": "4.7", "type": "tf", "text": "Комутатор надсилає кадр тільки на потрібний порт, а не всім одразу.", "correct": "Верно" },
    { "id": "4.8", "type": "tf", "text": "MAC-адреса та IP-адреса — це одне й те саме.", "correct": "Неверно" },
    { "id": "4.9", "type": "tf", "text": "Усередині LAN пристрої знаходять один одного за MAC-адресами.", "correct": "Верно" },
    { "id": "4.10", "type": "open", "text": "Чим MAC відрізняється від IP?" },
    { "id": "4.11", "type": "open", "text": "Навіщо потрібні VLAN?" },
    { "id": "4.12", "type": "open", "text": "Як комутатор дізнається, за яким портом який пристрій?" },
    { "id": "4.13", "type": "mc", "text": "Як комутатор дізнається розташування пристроїв?", "options": { "A": "З налаштувань вручну", "B": "Запам'ятовує MAC відправника з кадрів", "C": "Через DNS", "D": "Через DHCP" }, "correct": "B" },
    { "id": "4.14", "type": "mc", "text": "Що таке повний дуплекс?", "options": { "A": "Тільки приймання", "B": "Одночасно приймання і передавання", "C": "Тільки передавання", "D": "Розсилка всім" }, "correct": "B" },
    { "id": "4.15", "type": "mc", "text": "Що робить протокол ARP?", "options": { "A": "Шифрує", "B": "Знаходить MAC за IP", "C": "Роздає адреси", "D": "Веде маршрути" }, "correct": "B" },
    { "id": "4.16", "type": "tf", "text": "Broadcast-кадри йдуть по всьому широкомовному домену.", "correct": "Верно" },
    { "id": "4.17", "type": "tf", "text": "Напівдуплекс не породжує колізій.", "correct": "Неверно" },
    { "id": "4.18", "type": "open", "text": "Опиши самонавчання комутатора у двох реченнях." },
    { "id": "4.19", "type": "open", "text": "Навіщо потрібен протокол ARP?" },
    { "id": "4.20", "type": "open", "text": "Як зменшують широкомовний домен?" }
  ],
  "module-05": [
    { "id": "5.1", "type": "mc", "text": "Що робить маршрутизатор?", "options": { "A": "З'єднує вузли однієї LAN", "B": "З'єднує різні мережі та веде пакети", "C": "Роздає Wi-Fi", "D": "Зберігає паролі" }, "correct": "B" },
    { "id": "5.2", "type": "mc", "text": "Що таке шлюз за замовчуванням?", "options": { "A": "DNS-сервер", "B": "Адреса роутера для виходу за межі мережі", "C": "Ім'я мережі", "D": "Порт" }, "correct": "B" },
    { "id": "5.3", "type": "mc", "text": "За якими адресами маршрутизатор веде пакети?", "options": { "A": "MAC", "B": "IP", "C": "SSID", "D": "Порт" }, "correct": "B" },
    { "id": "5.4", "type": "mc", "text": "Як називається один крок пакета між маршрутизаторами?", "options": { "A": "Кадр", "B": "Стрибок (hop)", "C": "Порт", "D": "Сегмент" }, "correct": "B" },
    { "id": "5.5", "type": "mc", "text": "Що робить NAT?", "options": { "A": "Прискорює диск", "B": "Підміняє приватні адреси публічною", "C": "Роздає імена", "D": "Шифрує паролі" }, "correct": "B" },
    { "id": "5.6", "type": "mc", "text": "Що знає маршрутизатор про шлях пакета?", "options": { "A": "Весь шлях до цілі", "B": "Тільки наступний крок", "C": "Нічого", "D": "Тільки MAC цілі" }, "correct": "B" },
    { "id": "5.7", "type": "tf", "text": "traceroute показує шлях пакета через маршрутизатори.", "correct": "Верно" },
    { "id": "5.8", "type": "tf", "text": "Комутатор і маршрутизатор роблять одне й те саме.", "correct": "Неверно" },
    { "id": "5.9", "type": "tf", "text": "Без шлюзу за замовчуванням пристрій не вийде за межі своєї мережі.", "correct": "Верно" },
    { "id": "5.10", "type": "open", "text": "У чому різниця між комутатором і маршрутизатором?" },
    { "id": "5.11", "type": "open", "text": "Що робить шлюз за замовчуванням?" },
    { "id": "5.12", "type": "open", "text": "Чому маршрутизатору достатньо знати тільки наступний крок?" },
    { "id": "5.13", "type": "mc", "text": "Що таке маршрут за замовчуванням?", "options": { "A": "Найшвидший маршрут", "B": "Куди надсилати незнайомі адреси", "C": "Адреса DNS", "D": "MAC роутера" }, "correct": "B" },
    { "id": "5.14", "type": "mc", "text": "Принцип вибору маршруту називається:", "options": { "A": "shortest name", "B": "longest prefix match", "C": "first match", "D": "random" }, "correct": "B" },
    { "id": "5.15", "type": "mc", "text": "Чому traceroute показує шлях в один бік?", "options": { "A": "Помилка команди", "B": "Відповідь може йти іншим шляхом", "C": "Так швидше", "D": "Через NAT" }, "correct": "B" },
    { "id": "5.16", "type": "tf", "text": "Домашній роутер поєднує маршрутизатор, комутатор і точку доступу.", "correct": "Верно" },
    { "id": "5.17", "type": "tf", "text": "Локальний обмін між пристроями потребує шлюзу.", "correct": "Неверно" },
    { "id": "5.18", "type": "open", "text": "Що таке маршрут за замовчуванням і навіщо він потрібен?" },
    { "id": "5.19", "type": "open", "text": "Чому «локально працює, а інтернету немає»?" },
    { "id": "5.20", "type": "open", "text": "Що станеться, якщо для адреси немає жодного маршруту?" }
  ],
  "module-06": [
    { "id": "6.1", "type": "mc", "text": "Що робить DHCP?", "options": { "A": "Знаходить сайт", "B": "Автоматично видає мережеві налаштування", "C": "Шифрує Wi-Fi", "D": "Веде пакети" }, "correct": "B" },
    { "id": "6.2", "type": "mc", "text": "Що робить NAT на домашньому роутері?", "options": { "A": "Прискорює диск", "B": "Підміняє приватні адреси однією публічною", "C": "Роздає імена", "D": "Шифрує паролі" }, "correct": "B" },
    { "id": "6.3", "type": "mc", "text": "Що DHCP видає пристрою?", "options": { "A": "Тільки ім'я", "B": "IP, маску, шлюз і DNS", "C": "Тільки пароль Wi-Fi", "D": "Тільки MAC" }, "correct": "B" },
    { "id": "6.4", "type": "mc", "text": "Що означають літери DORA?", "options": { "A": "Назви портів", "B": "Кроки DHCP: Discover, Offer, Request, Acknowledge", "C": "Типи кабелів", "D": "Рівні OSI" }, "correct": "B" },
    { "id": "6.5", "type": "mc", "text": "Про що свідчить адреса 169.254.x.x?", "options": { "A": "Все гаразд", "B": "DHCP не відповів", "C": "Це публічна адреса", "D": "Це адреса роутера" }, "correct": "B" },
    { "id": "6.6", "type": "mc", "text": "Чому телефон у новій Wi-Fi мережі одразу працює?", "options": { "A": "Через NAT", "B": "Налаштування видав DHCP", "C": "Через DNS", "D": "Через VLAN" }, "correct": "B" },
    { "id": "6.7", "type": "tf", "text": "DHCP видає адресу в оренду на час, а не назавжди.", "correct": "Верно" },
    { "id": "6.8", "type": "tf", "text": "При NAT кожному пристрою потрібна своя публічна адреса.", "correct": "Неверно" },
    { "id": "6.9", "type": "tf", "text": "NAT — це повноцінний файрвол.", "correct": "Неверно" },
    { "id": "6.10", "type": "open", "text": "Що робить DHCP і навіщо він потрібен?" },
    { "id": "6.11", "type": "open", "text": "Що станеться, якщо DHCP видасть двом пристроям однакову адресу?" },
    { "id": "6.12", "type": "open", "text": "Своїми словами: як працює NAT?" },
    { "id": "6.13", "type": "mc", "text": "Що таке DHCP-резервування?", "options": { "A": "Заборона DHCP", "B": "Постійна адреса за MAC пристрою", "C": "Тип шифрування", "D": "Маршрут" }, "correct": "B" },
    { "id": "6.14", "type": "mc", "text": "Що таке проброс портів?", "options": { "A": "Прискорення", "B": "Правило, яке пускає зовнішні підключення всередину", "C": "Шифрування", "D": "Роздача імен" }, "correct": "B" },
    { "id": "6.15", "type": "mc", "text": "Що видає DHCP крім IP, маски і шлюзу?", "options": { "A": "Пароль", "B": "Адресу DNS", "C": "MAC", "D": "SSID" }, "correct": "B" },
    { "id": "6.16", "type": "tf", "text": "Не можна вручну задавати адреси з DHCP-пулу — буде конфлікт.", "correct": "Верно" },
    { "id": "6.17", "type": "tf", "text": "NAT замінює собою файрвол.", "correct": "Неверно" },
    { "id": "6.18", "type": "open", "text": "Навіщо потрібне DHCP-резервування?" },
    { "id": "6.19", "type": "open", "text": "Опиши ланцюжок «поганий DNS від DHCP → проблема»." },
    { "id": "6.20", "type": "open", "text": "Що відбувається з адресою пристрою, який пішов з мережі?" }
  ],
  "module-07": [
    { "id": "7.1", "type": "mc", "text": "Що таке SSID?", "options": { "A": "Пароль", "B": "Ім'я бездротової мережі", "C": "Тип шифрування", "D": "Частота" }, "correct": "B" },
    { "id": "7.2", "type": "mc", "text": "Який діапазон швидший, але з меншим радіусом?", "options": { "A": "2.4 ГГц", "B": "5 ГГц", "C": "Обидва однаково", "D": "Жоден" }, "correct": "B" },
