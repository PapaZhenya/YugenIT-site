    { "id": "8.14", "type": "mc", "text": "Для чого корисний безперервний ping (ping -t)?", "options": { "A": "Прискорити мережу", "B": "Ловити плаваючі обриви", "C": "Змінити адресу", "D": "Перевірити DNS" }, "correct": "B" },
    { "id": "8.15", "type": "mc", "text": "Якщо обрив traceroute на першому стрибку, проблема:", "options": { "A": "У провайдера", "B": "У тебе / твого роутера", "C": "На сайті", "D": "У DNS" }, "correct": "B" },
    { "id": "8.16", "type": "tf", "text": "Лампочки на роутері та мережевій картці допомагають у діагностиці.", "correct": "Верно" },
