  "module-08": [
    { "id": "8.1", "type": "mc", "text": "Що робить команда ping?", "options": { "A": "Показує шлях", "B": "Перевіряє доступність вузла", "C": "Видає IP", "D": "Шифрує" }, "correct": "B" },
    { "id": "8.2", "type": "mc", "text": "Що показує traceroute?", "options": { "A": "Швидкість диска", "B": "Шлях до вузла і де він обривається", "C": "Пароль", "D": "Ім'я мережі" }, "correct": "B" },
    { "id": "8.3", "type": "mc", "text": "Чим перевірити роботу DNS?", "options": { "A": "ping", "B": "nslookup", "C": "ipconfig", "D": "tracert" }, "correct": "B" },
    { "id": "8.4", "type": "mc", "text": "Чим подивитися свої мережеві налаштування?", "options": { "A": "nslookup", "B": "ipconfig / ip", "C": "ping", "D": "tracert" }, "correct": "B" },
    { "id": "8.5", "type": "mc", "text": "З чого починають діагностику за методом «знизу вгору»?", "options": { "A": "З DNS", "B": "З фізичного з'єднання", "C": "З сайту", "D": "З traceroute" }, "correct": "B" },
    { "id": "8.6", "type": "mc", "text": "Що з переліченого — часта причина «немає інтернету»?", "options": { "A": "Новий монітор", "B": "Неправильний шлюз або непрацюючий DNS", "C": "Яскравість екрана", "D": "Шпалери" }, "correct": "B" },
    { "id": "8.7", "type": "tf", "text": "Діагностику зручно вести по рівнях знизу вгору.", "correct": "Верно" },
    { "id": "8.8", "type": "tf", "text": "Якщо 8.8.8.8 пінгується, але сайти за іменами не відкриваються — винен, найімовірніше, DNS.", "correct": "Верно" },
    { "id": "8.9", "type": "tf", "text": "Правильно змінювати одразу кілька налаштувань за раз.", "correct": "Неверно" },
